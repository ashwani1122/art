generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Artwork {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  title      String
  image      Bytes
  width      Int
  height     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, templateId])
  @@index([userId, updatedAt])
}
